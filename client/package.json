{
  "name": "smart-plugs-client",
  "version": "0.1.0",
  "description": "A typed client for the routes of module com.github.aux.ccmpbll.prusa-connect-tasmota, generated from its OpenAPI fragment. It binds onto a @prusa/connect client.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:types": "openapi-typescript openapi.json -o src/generated/module-api.ts"
  },
  "peerDependencies": {
    "@prusa/connect": "0.1.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "@prusa/connect": "link:../.core/packages/typescript"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
